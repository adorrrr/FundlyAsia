# Fundly frontend configuration
# "mock" runs the whole app on in-browser demo data (default).
# "api" switches services to the HTTP client once the backend exists.
VITE_DATA_MODE=mock
VITE_API_BASE_URL=https://api.fundly.asia

# Dev with the local PHP server: VITE_DATA_MODE=api and VITE_API_BASE_URL=/api (proxied by Vite).
VITE_GOOGLE_CLIENT_ID=
