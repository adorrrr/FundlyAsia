# Copy to backend/.env (never commit .env) and fill in real values.
APP_ENV=production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fundly
DB_USER=
DB_PASS=
# Comma-separated browser origins allowed to call the API with cookies, e.g. https://fundly.asia
CORS_ALLOWED_ORIGINS=https://fundly.asia
# Public base URL where backend/public/uploads is served
UPLOAD_PUBLIC_URL=https://api.fundly.asia/uploads
